{
  "manifest_version": 3,
  "name": "AI求职助手 · BOSS自动连接",
  "version": "0.5.6",
  "description": "本项目专用浏览器组件：自动识别登录、读取与匹配岗位；不刷新同一页面、不读取Cookie、不发送消息。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "https://zhipin.com/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhipin.com/*",
        "https://zhipin.com/*"
      ],
      "js": [
        "reader.js",
        "observer.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "AI求职助手已自动连接"
  }
}